# Port for `pnpm dev` and `pnpm start`.
PORT=3002

# Public origin of this Next.js app (metadata, absolute links to this site).
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Existing Express API base (includes /api/v1).
NEXT_PUBLIC_API_BASE_URL=https://api.mcqanalysis.com/api/v1

# Socket.IO origin (optional; defaults to API host without /api/v1).
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5005

# Optional LiveKit URL override (join API normally returns livekitUrl).
# NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Cloudinary unsigned uploads (profile photo). Cloud name must match your active preset in the dashboard.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
